# .env.example — apps/web (Vite static site)
# VITE_API_URL: backend base URL. texto.html calls {VITE_API_URL}/web-session/…, voz.html
# calls POST {VITE_API_URL}/voice/session. Include the scheme — a bare host is not an
# absolute URL, so fetch resolves it against this site and 404s (api-base.js repairs it).
VITE_API_URL=http://localhost:3000

# Production — set in Vercel and REDEPLOY (Vite bakes VITE_* in at build time):
#   VITE_API_URL=https://asegura-web-production.up.railway.app
# The backend must also accept the origin — on Railway:
#   CORS_ORIGIN=https://asegura-app.vercel.app
#   WEB_APP_URL=https://asegura-app.vercel.app
