# .env.example — apps/web (Vite static site)
#
# VITE_API_URL: URL base del backend NestJS. texto.html llama {VITE_API_URL}/web-session/…
# y voz.html llama POST {VITE_API_URL}/voice/session (sesión de voz LiveKit).
#
# DEBE incluir el esquema. Un host pelado ("asegura-web-production.up.railway.app") NO es
# una URL absoluta para el navegador: fetch() lo resuelve como ruta relativa y termina
# pegándole a https://<el-sitio-estático>/asegura-web-production.up.railway.app/web-session/…
# → 404 del propio Vercel, que en pantalla se ve como "No se pudo conectar".
# (api-base.js ya corrige ese caso agregando https://, pero escríbela completa.)
#
# Local: el puerto del backend (ver PORT en el .env.example de la raíz).
VITE_API_URL=http://localhost:3000

# Producción (definir en Vercel → Settings → Environment Variables, y RE-DESPLEGAR:
# Vite congela las VITE_* en el bundle en tiempo de build, no se leen en runtime):
#   VITE_API_URL=https://asegura-web-production.up.railway.app
#
# El backend además tiene que aceptar ese origen — en Railway:
#   CORS_ORIGIN=https://asegura-app.vercel.app
#   WEB_APP_URL=https://asegura-app.vercel.app
