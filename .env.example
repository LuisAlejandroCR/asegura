# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# ── Supabase (Sprint 0) ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── LLM (Sprint 1) ─────────────────────────────────────────────────────────────
# Groq (recommended): LLM_API_KEY from https://console.groq.com/keys, LLM_MODEL=openai/gpt-oss-120b
# Ollama (local): LLM_BASE_URL=http://localhost:11434, LLM_MODEL=mistral
LLM_BASE_URL=
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b

# ── Telegram (Sprint 1) ────────────────────────────────────────────────────────
# PUBLIC_URL: this app's public base URL (used to register the Telegram webhook).
# Leave unset for local polling mode — no TELEGRAM_WEBHOOK_SECRET needed then.
PUBLIC_URL=https://your-app.up.railway.app
TELEGRAM_BOT_TOKEN=1234567890:AAF...
TELEGRAM_WEBHOOK_SECRET=your-random-secret-32-chars

# ── Twilio WhatsApp Sandbox ─────────────────────────────────────────────────────
# Sandbox: console.twilio.com > Messaging > Try it out > Send a WhatsApp message.
# TWILIO_WHATSAPP_NUMBER is the sandbox number (shared), e.g. whatsapp:+14155238886.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── LiveKit (AseguraWeb voice) ──────────────────────────────────────────────────
# cloud.livekit.io > project settings > Keys. LIVEKIT_URL is the wss:// project URL.
# Needed by both the NestJS token endpoint AND the separate voice-agent worker
# (src/voice-agent/main.ts, deployed as its own process — not part of `node dist/main`).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=...

# ── ElevenLabs (voice-agent worker TTS only) ────────────────────────────────────
# elevenlabs.io > Voices — pick/clone the voice, copy its id (e.g. the "Aitana" voice
# already used for the pitch narration, Sesión 76 — see docs/memoria.md).
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# ── Wompi (Sprint 5) ──────────────────────────────────────────────────────────
WOMPI_ENVIRONMENT=sandbox
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_SECRET=...

# Celo (CELO_RPC_URL, OPERATOR_PRIVATE_KEY, POLICY_LEDGER_ADDRESS) removed: nothing reads
# them since blockchain moved to future work. Re-add here and in env.validation.ts
# together if it comes back.

# ── App (Sprint 2+) ───────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_CHAT_ID=your-telegram-chat-id
