{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm run build",
    "watchPatterns": [
      "src/**",
      "package.json",
      "pnpm-lock.yaml",
      "tsconfig*.json",
      "nest-cli.json",
      "railway.voice.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm run voice-agent:start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
