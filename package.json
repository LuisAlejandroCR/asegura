{
  "name": "asegura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "dev": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "voice-agent:dev": "node ./node_modules/@nestjs/cli/bin/nest.js build && node dist/voice-agent/main.js dev",
    "voice-agent:start": "node dist/voice-agent/main.js start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@livekit/agents": "^1.6.2",
    "@livekit/agents-plugin-elevenlabs": "^1.6.2",
    "@livekit/agents-plugin-openai": "^1.6.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "helmet": "^7.0.0",
    "js-yaml": "^4.1.0",
    "livekit-client": "^2.21.0",
    "livekit-server-sdk": "^2.17.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
